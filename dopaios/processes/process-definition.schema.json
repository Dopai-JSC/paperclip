{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dopaios.local/schemas/process-definition-1.0.json",
  "title": "Dopaios process definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "sourceAuthority", "initial", "states"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "sourceAuthority": { "const": "business-text" },
    "initial": { "type": "string", "minLength": 1 },
    "inputs": { "$ref": "#/definitions/stringArray" },
    "outputs": { "$ref": "#/definitions/stringArray" },
    "runtimeContracts": { "$ref": "#/definitions/stringArray" },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/state" }
    },
    "sourceContracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sourceContract" }
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "automaticState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "activity", "evidence", "onCompleted"],
      "properties": {
        "kind": { "const": "automatic" },
        "actor": { "type": "string", "minLength": 1 },
        "activity": { "type": "string", "minLength": 1 },
        "activationGuards": { "$ref": "#/definitions/stringArray" },
        "inputs": { "$ref": "#/definitions/stringArray" },
        "outputs": { "$ref": "#/definitions/stringArray" },
        "evidence": { "$ref": "#/definitions/stringArray" },
        "onCompleted": { "type": "string", "minLength": 1 }
      }
    },
    "humanDecisionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "evidence", "decisions"],
      "properties": {
        "kind": { "const": "human-decision" },
        "actor": { "type": "string", "minLength": 1 },
        "activationGuards": { "$ref": "#/definitions/stringArray" },
        "inputs": { "$ref": "#/definitions/stringArray" },
        "evidence": { "$ref": "#/definitions/stringArray" },
        "decisionEffects": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/stringArray" }
        },
        "decisions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "finalState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "final" } }
    },
    "state": {
      "oneOf": [
        { "$ref": "#/definitions/automaticState" },
        { "$ref": "#/definitions/humanDecisionState" },
        { "$ref": "#/definitions/finalState" }
      ]
    },
    "sourceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceContains", "processPath", "equals"],
      "properties": {
        "sourceContains": { "type": "string", "minLength": 1 },
        "processPath": { "type": "string", "pattern": "^/" },
        "equals": {}
      }
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "path", "gitBlob", "assertions"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "gitBlob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/sourceAssertion" }
        }
      }
    }
  }
}
